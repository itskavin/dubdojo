   ],
   "lines": [
    {
     "id": "l1",
     "start": 341.31,
     "end": 343.42,
     "speaker": "proog",
     "text": "Emo, close your eyes."
    },
    {
     "id": "l2",
     "start": 344.15,
     "end": 344.773,
     "speaker": "emo",
     "text": "Why?"
    },
    {
     "id": "l3",
     "start": 344.773,
     "end": 345.396,
     "speaker": "proog",
     "text": "Now!"
    },
    {
     "id": "l4",
     "start": 351.15,
     "end": 351.97,
     "speaker": "emo",
     "text": "OK."
    },
    {
     "id": "l5",
     "start": 353.11,
     "end": 354.68,
     "speaker": "proog",
     "text": "Good."
    },
    {
     "id": "l6",
     "start": 359.42,
     "end": 362.1,
     "speaker": "proog",
     "text": "What do you see at your left side, Emo?"
    },
    {
     "id": "l7",
     "start": 364.02,
     "end": 365.01,
     "speaker": "emo",
     "text": "Nothing."
    },
    {
     "id": "l8",
     "start": 365.01,
     "end": 366.0,
     "speaker": "proog",
     "text": "Really?"
    },
    {
     "id": "l9",
     "start": 366.0,
     "end": 367.58,
     "speaker": "emo",
     "text": "No, nothing at all."
    },
    {
     "id": "l10",
     "start": 367.58,
     "end": 371.98,
     "speaker": "proog",
     "text": "Really? A–And at your right? What do you see at your right side, Emo?"
    },
    {
     "id": "l11",
     "start": 373.31,
     "end": 376.84,
     "speaker": "emo",
     "text": "The same, Proog. Exactly the same…"
    },
    {
     "id": "l12",
     "start": 376.84,
     "end": 378.368,
     "speaker": "emo",
     "text": "…nothing!"
    },
    {
     "id": "l13",
     "start": 378.368,
     "end": 379.896,
     "speaker": "proog",
     "text": "Great."
    }
   ]
