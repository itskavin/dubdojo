   ],
   "lines": [
    {
     "id": "l1",
     "start": 140.0,
     "end": 141.3,
     "speaker": "victor",
     "text": "Excuse me?"
    },
    {
     "id": "l2",
     "start": 141.8,
     "end": 143.0,
     "speaker": "victor",
     "text": "Excuse me, sir?"
    },
    {
     "id": "l3",
     "start": 144.0,
     "end": 145.5,
     "speaker": "victor",
     "text": "Excuse me?"
    },
    {
     "id": "l4",
     "start": 147.0,
     "end": 149.0,
     "speaker": "franck",
     "text": "Oh, come on."
    },
    {
     "id": "l5",
     "start": 150.0,
     "end": 152.042,
     "speaker": "victor",
     "text": "Do you have a moment, sir?"
    },
    {
     "id": "l6",
     "start": 152.125,
     "end": 154.958,
     "speaker": "franck",
     "text": "I'm kind of in the middle of something here."
    },
    {
     "id": "l7",
     "start": 155.042,
     "end": 157.0,
     "speaker": "victor",
     "text": "Yes? Thank you."
    },
    {
     "id": "l8",
     "start": 157.05,
     "end": 159.326,
     "speaker": "victor",
     "text": "I've come a long way for you, Franck."
    },
    {
     "id": "l9",
     "start": 169.0,
     "end": 171.0,
     "speaker": "victor",
     "text": "My name is Victor."
    },
    {
     "id": "l10",
     "start": 172.0,
     "end": 174.0,
     "speaker": "victor",
     "text": "Hi."
    },
    {
     "id": "l11",
     "start": 174.0,
     "end": 176.125,
     "speaker": "victor",
     "text": "And you are…"
    },
    {
     "id": "l12",
     "start": 177.813,
     "end": 179.5,
     "speaker": "victor",
     "text": "You are Franck."
    },
    {
     "id": "l13",
     "start": 180.5,
     "end": 184.0,
     "speaker": "victor",
     "text": "You are so much more than just a sheep, aren't you?"
    },
    {
     "id": "l14",
     "start": 185.0,
     "end": 188.0,
     "speaker": "franck",
     "text": "Oh yeah? How would you know?"
    },
    {
     "id": "l15",
     "start": 190.346,
     "end": 192.75,
     "speaker": "victor",
     "text": "Look at you. You're an adventurer, Franck."
    },
    {
     "id": "l16",
     "start": 193.958,
     "end": 196.75,
     "speaker": "victor",
     "text": "Just like me, you're... a lone wolf."
    },
    {
     "id": "l17",
     "start": 198.625,
     "end": 201.75,
     "speaker": "victor",
     "text": "Tell me, does one choose to be alone?"
    },
    {
     "id": "l18",
     "start": 202.917,
     "end": 205.08,
     "speaker": "victor",
     "text": "No, one doesn't."
    },
    {
     "id": "l19",
     "start": 205.17,
     "end": 207.75,
     "speaker": "victor",
     "text": "One doesn't even choose to be a wolf."
    },
    {
     "id": "l20",
     "start": 209.88,
     "end": 211.0,
     "speaker": "victor",
     "text": "Or does one?"
    }
   ]
