   "license": "CC BY 2.5",
   "shareAlike": false,
   "attribution": "Elephants Dream (2006) by the Orange Open Movie Project (Blender Foundation / Netherlands Media Art Institute), orange.blender.org, licensed CC BY 2.5",
   "sourcePage": "https://commons.wikimedia.org/wiki/File:Elephants_Dream_(2006).webm",
   "thumb": "https://upload.wikimedia.org/wikipedia/commons/thumb/a/a2/Elephants_Dream_%282006%29.webm/960px-seek%3D449-Elephants_Dream_%282006%29.webm.jpg",
   "thumbAt": 449,
   "characters": [
    {
     "id": "proog",
     "name": "Proog",
     "color": "#ff8a4c",
     "voice": {
      "engine": "kokoro",
      "id": "bm_fable",
      "rate": 1,
      "pitch": 1
     }
    },
    {
     "id": "emo",
     "name": "Emo",
     "color": "#5cc8ff",
     "voice": {
      "engine": "kokoro",
      "id": "am_michael",
      "rate": 1,
      "pitch": 1
     }
    }
   ],
   "lines": [
    {
     "id": "l1",
     "start": 429.05,
     "end": 430.08,
     "speaker": "proog",
     "text": "Emo?"
    },
    {
     "id": "l2",
     "start": 431.14,
     "end": 433.08,
     "speaker": "proog",
     "text": "Emo, why?!"
    },
    {
     "id": "l3",
     "start": 433.08,
     "end": 435.36,
     "speaker": "proog",
     "text": "Emo, why…?"
    },
    {
     "id": "l4",
     "start": 435.36,
     "end": 438.84,
     "speaker": "proog",
     "text": "Why can’t you see the beauty of this place?"
    },
    {
     "id": "l5",
     "start": 438.84,
     "end": 440.646,
     "speaker": "proog",
     "text": "The way it works."
    },
    {
     "id": "l6",
     "start": 440.646,
     "end": 443.92,
     "speaker": "proog",
     "text": "How… How perfect it is."
    },
    {
     "id": "l7",
     "start": 443.92,
     "end": 447.04,
     "speaker": "emo",
     "text": "No, Proog, I don’t see."
    },
    {
     "id": "l8",
     "start": 447.04,
     "end": 449.97,
     "speaker": "emo",
     "text": "I don’t see because there’s nothing there."
    },
    {
     "id": "l9",
     "start": 451.05,
     "end": 455.24,
     "speaker": "emo",
     "text": "And why should I trust my life to something that isn’t there?"
    },
    {
     "id": "l10",
     "start": 455.24,
     "end": 456.6,
     "speaker": "emo",
     "text": "Well, can you tell me that?"
    },
    {
     "id": "l11",
     "start": 456.6,
     "end": 457.38,
     "speaker": "proog",
     "text": "Emo…"
    },
    {
     "id": "l12",
     "start": 457.38,
     "end": 458.92,
     "speaker": "emo",
     "text": "Answer me!"
    },
    {
     "id": "l13",
     "start": 462.97,
     "end": 464.0,
     "speaker": "emo",
     "text": "Proog…"
    },
    {
     "id": "l14",
     "start": 465.05,
     "end": 466.854,
     "speaker": "emo",
     "text": "…you’re a sick man!"
    },
    {
     "id": "l15",
     "start": 466.854,
     "end": 468.91,
     "speaker": "emo",
     "text": "Stay away from me!"
    }
   ]
