  {
   "id": "elephants-beauty-of-this-place",
   "title": "Elephants Dream: You're a Sick Man",
   "film": "Elephants Dream (2006)",
   "style": "animation",
   "difficulty": "hard",
   "videoUrl": "https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a2/Elephants_Dream_%282006%29.webm/Elephants_Dream_%282006%29.webm.480p.vp9.webm",
