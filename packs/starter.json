     "start": 168.84,
     "end": 169.6,
     "speaker": "ivan",
     "text": "But why?"
    },
    {
     "id": "l11",
     "start": 169.84,
     "end": 172.16,
     "speaker": "marya",
     "text": "Just don't!"
